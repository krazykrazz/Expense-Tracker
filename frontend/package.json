{
  "name": "expense-tracker-frontend",
  "version": "1.10.1",
  "description": "Expense Tracker React Frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:parallel": "vitest --run --pool=forks --poolOptions.forks.maxForks=75%",
    "test:watch": "vitest",
    "test:changed": "vitest --changed --run",
    "test:fast": "cross-env FAST_CHECK_NUM_RUNS=10 vitest --run",
    "test:fast:parallel": "cross-env FAST_CHECK_NUM_RUNS=10 vitest --run --pool=forks --poolOptions.forks.maxForks=75%",
    "test:core": "vitest --run ExpenseForm.core",
    "test:sections": "vitest --run ExpenseForm.sections",
    "test:people": "vitest --run ExpenseForm.people",
    "test:futureMonths": "vitest --run ExpenseForm.futureMonths",
    "test:dataPreservation": "vitest --run ExpenseForm.dataPreservation",
    "test:perf": "node ../scripts/measure-test-performance.js"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.0",
    "baseline-browser-mapping": "^2.11.22",
    "cross-env": "^10.1.0",
    "fast-check": "^4.10.0",
    "jsdom": "^30.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
